# Salin menjadi .env di folder ai-scanner/ lalu isi nilainya

# --- Integrasi Payment Gateway (folder payment-gateway/) ---
GATEWAY_URL=http://localhost:3000
GATEWAY_API_KEY=    # Samakan dengan API_KEY di payment-gateway/.env
GATEWAY_UNIQUE_CODE=0
GATEWAY_TIMEOUT=8
# Isi 1 hanya saat pengembangan: mengaktifkan /api/sim_payment dan tombol simulasi
DEV_SIM_PAYMENT=0

# --- Hanya untuk training/download_dataset.py ---
ROBOFLOW_KEY=
